# Copy this file to .env and fill in your own values. .env is in .gitignore:
# it holds passwords, so never commit it. Variables already set in the
# environment win over the file.

# The database. Leave it out to use the SQLite file price_tracker.db instead.
DATABASE_URL=postgresql+psycopg://price_tracker:CHANGE-ME@localhost:5432/price_tracker

# An empty database the tests may wipe, for `pytest --postgres`. Its name must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://price_tracker:CHANGE-ME@localhost:5432/price_tracker_test
